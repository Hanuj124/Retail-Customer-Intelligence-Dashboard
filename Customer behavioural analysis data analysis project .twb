      <aliases enabled='yes' />
      <column caption='Total Revenue' datatype='integer' name='[Calculation_0895417023430656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([purchase_amount])' />
      </column>
      <column caption='Average Purchase Amount' datatype='real' name='[Calculation_0895417024217089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([purchase_amount])' />
      </column>
      <column caption='Customer Type' datatype='string' name='[Calculation_0895417024479234]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [previous_purchases] &gt; 5 THEN &quot;Repeat Customer&quot;&#10;ELSE &quot;New Customer&quot;&#10;END' />
      </column>
      <column caption='Loyalty Segment' datatype='string' name='[Calculation_0895417024696323]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [previous_purchases] &gt;= 20 THEN &quot;Loyal&quot;&#10;ELSEIF [previous_purchases] &gt;= 10 THEN &quot;Returning&quot;&#10;ELSE &quot;New&quot;&#10;END' />
      </column>
      <column caption='Discount Used' datatype='integer' name='[Calculation_0895417024806916]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [discount_applied] = &quot;Yes&quot; THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Repeat Purchase Rate' datatype='real' name='[Calculation_0895417030803461]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [previous_purchases] &gt; 5 THEN 1 ELSE 0 END&#10;)&#10;/ COUNT([customer_id])' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_0895417031073798]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='' />
      </column>
      <column caption='Subscription Revenue %' datatype='real' name='[Calculation_0895417031147527]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [subscription_status]=&quot;Yes&quot;&#10;THEN [purchase_amount]&#10;END&#10;)&#10;/ SUM([purchase_amount])' />
      </column>
      <column caption='Average Review Rating' datatype='real' name='[Calculation_0895417031274504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([review_rating])' />
      </column>
      <column caption='customers' datatype='integer' name='[Calculation_0895417042968585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count([customer_id])' />
      </column>
      <column caption='Category Rank' datatype='integer' name='[Calculation_0895417120165898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(COUNT([customer_id]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
